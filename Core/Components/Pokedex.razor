

<div class="pokedex-container">                                                                                                                                                                                   
    <div class="grid-container">
        @for (int i = 1; i <= 151; i++)                                                                                                                                                                            
        {                                                                                                                                                                                                          
            <div class="number-container">                                                                                                                                                                         
                <div class="number">@i</div>                                                                                                                                                                       
            </div>                                                                                                                                                                                                 
        }                                                                                                                                                                                                          
    </div>                                                                                                                                                                                                         
</div>                                                                                                                                                                                                             