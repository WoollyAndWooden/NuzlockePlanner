@using Core.Services


<div class="pokedex-container">                                                                                                                                                                                   
    <div class="grid-container">
        @if (_pokedex is not null)
        {
            @for(int i = 1; i < _pokedex.aggregateCount; i++)
            {
                var pokemon = _pokedex.pokemon_entries?.FirstOrDefault(x => x.pokemon_species?.Id == i);
                <div class="number-container">
                    <img src="@_spriteState.GetSprite(pokemon?.pokemon_species?.Name)"/>
                </div>
            }
        }
    </div>                                                                                                                                                                                                         
</div>                                                                                                                                                                                                             