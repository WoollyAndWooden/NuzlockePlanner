<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
        <PublishTrimmed>true</PublishTrimmed>
        <WasmFingerprintAssets>false</WasmFingerprintAssets>
        <GenerateMvcApplicationPartsAssembly>false</GenerateMvcApplicationPartsAssembly>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Core\Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="obj\" />
    </ItemGroup>

    <Target Name="ConfigureForGitHubPages" AfterTargets="Publish" Condition="'$(GHPages)' == 'true'">
        <Message Text="Configuring for GitHub Pages (Base Tag + .nojekyll)..." Importance="high" />
        <Exec Command="sed -i 's|&lt;base href=&quot;/&quot; /&gt;|&lt;base href=&quot;/NuzlockePlanner/&quot; /&gt;|g' &quot;$(PublishDir)wwwroot/index.html&quot;" />
        <Exec Command="touch &quot;$(PublishDir)wwwroot/.nojekyll&quot;" />
    </Target>

</Project>
