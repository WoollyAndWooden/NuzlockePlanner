<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NuzlockePlanner.Shared\NuzlockePlanner.Shared.csproj" />
  </ItemGroup>

  <!-- Custom Target to configure the app for GitHub Pages deployment -->
  <Target Name="ConfigureForGitHubPages" AfterTargets="Publish" Condition="'$(GHPages)' == 'true'">
    <Message Text="Configuring for GitHub Pages..." Importance="high" />
    
    <!-- Update base tag -->
    <Exec Command="sed -i 's|&lt;base href=&quot;/&quot; /&gt;|&lt;base href=&quot;/NuzlockePlanner/&quot; /&gt;|g' &quot;$(PublishDir)wwwroot/index.html&quot;" />
    
    <!-- Create .nojekyll -->
    <Exec Command="touch &quot;$(PublishDir)wwwroot/.nojekyll&quot;" />
    
    <!-- Find the hashed blazor.webassembly.js file -->
    <ItemGroup>
      <HashedFile Include="$(PublishDir)wwwroot/_framework/blazor.webassembly.*.js" />
    </ItemGroup>
    
    <!-- Copy it to blazor.webassembly.js -->
    <Copy SourceFiles="@(HashedFile)" DestinationFiles="$(PublishDir)wwwroot/_framework/blazor.webassembly.js" Condition="'@(HashedFile)' != ''" />
    
    <Message Text="Copied @(HashedFile) to blazor.webassembly.js" Importance="high" />
  </Target>

</Project>
